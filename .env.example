OPENAI_API_KEY=your_openai_api_key_here

# Required for any public deployment that can call an AI model.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key

# Local development only. Setting this to true deliberately disables server-side
# AI quotas when Supabase is absent. Never enable it in a public deployment.
ALLOW_LOCAL_UNMETERED_AI=false

# Server-only dashboard. Never expose or commit this key.
SUPABASE_SECRET_KEY=your_private_secret_key
# Legacy fallback only when no sb_secret_ key is available:
# SUPABASE_SERVICE_ROLE_KEY=your_private_service_role_key
BETA_START_AT=2026-08-09T17:00:00+08:00
# Preferred: comma-separated authenticated administrator email allowlist.
ADMIN_EMAILS=admin@example.com
# Fallback only when ADMIN_EMAILS is empty.
ADMIN_PASSWORD=choose_a_private_dashboard_password

# Optional founder-pass manual-payment setup. The QR URL is optional; keep any
# configured payment details server-side. Users submit an order reference, not a screenshot.
FOUNDER_PAYMENT_QR_URL=
FOUNDER_PAYMENT_INSTRUCTIONS=
FOUNDER_SUPPORT_CONTACT=
FOUNDER_REFUND_POLICY=
